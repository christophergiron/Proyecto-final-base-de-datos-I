@model ComprobanteVm
@{
    var p = Model.Pago;
    var c = Model.Credito;
    var q = Model.Cuota;
    var numero = p["NumeroCredito"];
    var comprobante = p["NumeroComprobante"];
    var sinComprobante = string.IsNullOrWhiteSpace(comprobante);
    ViewData["Title"] = sinComprobante ? "Comprobante de pago" : "Comprobante " + comprobante;
    var referencia = p["ReferenciaBancaria"];
    var cliente = p["Cliente"] ?? c?["Cliente"];
    var cuotaPago = p["Cuota"];
    var numeroPago = p["NumeroPago"];
}

@if (Model.Nuevo)
{
    <section class="mg-exito no-print" role="status">
        <i class="bi bi-check-circle-fill"></i>
        <div>
            <small>Pago registrado correctamente</small>
            <strong>@(sinComprobante ? "Pago " + p["NumeroPago"] : comprobante)</strong>
            @if (q is not null)
            {
                <span>Saldo pendiente de la cuota @q["Cuota"]: <b>@Formato.Quetzales(q.Decimal("Pendiente"))</b> · estado <b>@q["EstadoCuota"]</b></span>
            }
        </div>
    </section>
}

<div class="mg-encabezado no-print">
    <div>
        <h1>Comprobante de pago</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Cuenta" asp-route-numero="@numero">
            <i class="bi bi-arrow-left me-1"></i>Pagos y cuotas del crédito
        </a>
        <button type="button" class="btn btn-primary" data-imprimir><i class="bi bi-printer me-1"></i>Imprimir</button>
        <a class="btn btn-success" asp-action="Registrar" asp-route-numero="@numero">
            <i class="bi bi-cash-coin me-1"></i>Registrar otro pago
        </a>
    </div>
</div>

<article class="mg-comprobante">
    <header class="mg-comprobante-encabezado">
        <img src="~/img/logo.png" alt="MAGIS-AUTO Crédito Financiero Automotriz" />
        <div class="text-end">
            <div class="mg-comprobante-titulo">Comprobante de pago</div>
            <div class="mg-comprobante-numero">@(sinComprobante ? "Sin número de comprobante" : comprobante)</div>
            <div class="text-muted">@p.Mostrar("FechaPago")</div>
        </div>
    </header>

    <dl class="row mg-datos mb-3">
        <dt class="col-sm-4">Cliente</dt>
        <dd class="col-sm-8">@cliente</dd>
        <dt class="col-sm-4">Crédito</dt>
        <dd class="col-sm-8">@numero</dd>
        @if (c is not null && !string.IsNullOrEmpty(c["Vehiculo"]))
        {
            <dt class="col-sm-4">Vehículo</dt>
            <dd class="col-sm-8">@c["Vehiculo"]</dd>
        }
        <dt class="col-sm-4">Cuota pagada</dt>
        <dd class="col-sm-8">Cuota @p["Cuota"] · pago @p["NumeroPago"]</dd>
        <dt class="col-sm-4">Tipo de pago</dt>
        <dd class="col-sm-8">@p["TipoPago"]</dd>
        @if (!string.IsNullOrWhiteSpace(referencia))
        {
            <dt class="col-sm-4">Referencia bancaria</dt>
            <dd class="col-sm-8">@referencia</dd>
        }
    </dl>

    <div class="mg-comprobante-monto">
        <span>Monto pagado</span>
        <strong>@Formato.Quetzales(p.Decimal("Monto"))</strong>
    </div>

    <dl class="row mg-datos mt-3 mb-0">
        @if (q is not null)
        {
            <dt class="col-sm-4">Total de la cuota</dt>
            <dd class="col-sm-8">@Formato.Quetzales(q.Decimal("TotalCuota"))</dd>
            <dt class="col-sm-4">Pagado en la cuota</dt>
            <dd class="col-sm-8">@Formato.Quetzales(q.Decimal("Pagado"))</dd>
            <dt class="col-sm-4">Saldo pendiente de la cuota</dt>
            <dd class="col-sm-8">@Formato.Quetzales(q.Decimal("Pendiente"))
                <span class="badge @EstadosCuota.Clase(q["EstadoCuota"]) ms-1">@q["EstadoCuota"]</span></dd>
        }
        @if (c is not null && c.Tiene("SaldoPendiente"))
        {
            <dt class="col-sm-4">Saldo pendiente del crédito</dt>
            <dd class="col-sm-8 fw-semibold">@Formato.Quetzales(c.Decimal("SaldoPendiente"))</dd>
        }
    </dl>

    <footer class="mg-comprobante-pie">
        MAGIS-AUTO · Crédito Financiero Automotriz · Guatemala<br />
        Este comprobante respalda el pago registrado en el sistema.
    </footer>
</article>

<div class="d-flex gap-2 mt-3 no-print">
    <a class="btn btn-outline-secondary btn-sm" asp-action="Editar" asp-route-numero="@numero"
       asp-route-cuota="@cuotaPago" asp-route-pago="@numeroPago"><i class="bi bi-pencil me-1"></i>Editar tipo, referencia o fecha</a>
</div>
