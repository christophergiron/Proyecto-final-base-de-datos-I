@model ReferenciaFormVm
@{
    var titulo = Model.Edicion ? "Editar referencia" : "Nueva referencia";
    ViewData["Title"] = titulo;
    var tipos = Model.Tipos.Select(o => new SelectListItem(o.Texto, o.Valor)).ToList();
}

<div class="mg-encabezado">
    <div>
        <h1>@titulo</h1>
        <p>Los campos marcados con <span class="text-danger">*</span> son obligatorios.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i>Volver a referencias
    </a>
</div>

<form asp-action="@(Model.Edicion ? "Editar" : "Crear")" method="post" class="mg-panel" data-bloquear>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.Edicion)
    {
        <input type="hidden" asp-for="Form.CodigoReferencia" />
    }

    <h2 class="mg-subtitulo">Datos de la persona</h2>
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.PrimerNombre" class="form-label">Primer nombre <span class="text-danger">*</span></label>
            <input asp-for="Form.PrimerNombre" class="form-control" required maxlength="60" autocomplete="off" />
            <span asp-validation-for="Form.PrimerNombre" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.SegundoNombre" class="form-label">Segundo nombre</label>
            <input asp-for="Form.SegundoNombre" class="form-control" maxlength="60" autocomplete="off" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.PrimerApellido" class="form-label">Primer apellido <span class="text-danger">*</span></label>
            <input asp-for="Form.PrimerApellido" class="form-control" required maxlength="60" autocomplete="off" />
            <span asp-validation-for="Form.PrimerApellido" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.SegundoApellido" class="form-label">Segundo apellido</label>
            <input asp-for="Form.SegundoApellido" class="form-control" maxlength="60" autocomplete="off" />
        </div>

        <div class="col-12 col-md-6">
            <label asp-for="Form.CodigoTipoReferencia" class="form-label">Tipo de referencia <span class="text-danger">*</span></label>
            <select asp-for="Form.CodigoTipoReferencia" asp-items="tipos" class="form-select" required>
                <option value="">— Seleccione —</option>
            </select>
            <span asp-validation-for="Form.CodigoTipoReferencia" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Form.LugarTrabajo" class="form-label">Lugar de trabajo</label>
            <input asp-for="Form.LugarTrabajo" class="form-control" autocomplete="off" />
        </div>
    </div>

    @if (!Model.Edicion)
    {
        <h2 class="mg-subtitulo">Teléfonos</h2>
        <p class="text-muted small mb-2">
            <i class="bi bi-info-circle me-1"></i>Escriba al menos uno.
        </p>
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <label asp-for="Form.TelefonoCelular" class="form-label">Celular</label>
                <input asp-for="Form.TelefonoCelular" class="form-control" inputmode="tel" autocomplete="off" />
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="Form.TelefonoCasa" class="form-label">Casa</label>
                <input asp-for="Form.TelefonoCasa" class="form-control" inputmode="tel" autocomplete="off" />
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="Form.TelefonoTrabajo" class="form-label">Trabajo</label>
                <input asp-for="Form.TelefonoTrabajo" class="form-control" inputmode="tel" autocomplete="off" />
            </div>
        </div>
    }
    else
    {
        <p class="text-muted small">
            <i class="bi bi-info-circle me-1"></i>Los teléfonos de una referencia no se modifican desde aquí.
        </p>
    }

    <div class="d-flex flex-wrap gap-2 justify-content-end">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>@(Model.Edicion ? "Guardar cambios" : "Registrar referencia")
        </button>
    </div>
</form>
