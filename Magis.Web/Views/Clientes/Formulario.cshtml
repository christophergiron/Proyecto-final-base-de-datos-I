@model ClienteFormVm
@{
    var titulo = Model.Edicion ? "Editar cliente" : "Nuevo cliente";
    ViewData["Title"] = titulo;
    var tipos = Model.TiposTelefono.Select(o => new SelectListItem(o.Texto, o.Valor)).ToList();
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="mg-encabezado">
    <div>
        <h1>@titulo</h1>
        <p>Los campos marcados con <span class="text-danger">*</span> son obligatorios.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i>Volver a clientes
    </a>
</div>

<form asp-action="@(Model.Edicion ? "Editar" : "Crear")" method="post" class="mg-panel" data-bloquear>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.Edicion)
    {
        <input type="hidden" asp-for="Form.CodigoDeudor" />
    }

    <h2 class="mg-subtitulo">Datos personales</h2>
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.PrimerNombre" class="form-label">Primer nombre <span class="text-danger">*</span></label>
            <input asp-for="Form.PrimerNombre" class="form-control" required maxlength="60" autocomplete="off" />
            <span asp-validation-for="Form.PrimerNombre" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.SegundoNombre" class="form-label">Segundo nombre</label>
            <input asp-for="Form.SegundoNombre" class="form-control" maxlength="60" autocomplete="off" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.PrimerApellido" class="form-label">Primer apellido <span class="text-danger">*</span></label>
            <input asp-for="Form.PrimerApellido" class="form-control" required maxlength="60" autocomplete="off" />
            <span asp-validation-for="Form.PrimerApellido" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.SegundoApellido" class="form-label">Segundo apellido</label>
            <input asp-for="Form.SegundoApellido" class="form-control" maxlength="60" autocomplete="off" />
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.FechaNacimiento" class="form-label">Fecha de nacimiento <span class="text-danger">*</span></label>
            <input asp-for="Form.FechaNacimiento" type="date" class="form-control" required max="@hoy" />
            <span asp-validation-for="Form.FechaNacimiento" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.Genero" class="form-label">Género</label>
            <select asp-for="Form.Genero" class="form-select">
                <option value="">— Sin especificar —</option>
                <option value="M">Masculino</option>
                <option value="F">Femenino</option>
            </select>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.DPI" class="form-label">DPI <span class="text-danger">*</span></label>
            <input asp-for="Form.DPI" class="form-control" required inputmode="numeric" maxlength="13"
                   placeholder="13 dígitos" autocomplete="off" />
            <span asp-validation-for="Form.DPI" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.NIT" class="form-label">NIT <span class="text-danger">*</span></label>
            <input asp-for="Form.NIT" class="form-control" required placeholder="1234567-8" autocomplete="off" />
            <span asp-validation-for="Form.NIT" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.NoPasaporte" class="form-label">No. de pasaporte</label>
            <input asp-for="Form.NoPasaporte" class="form-control" autocomplete="off" />
        </div>
    </div>

    <h2 class="mg-subtitulo">Contacto</h2>
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-6">
            <label asp-for="Form.Correo" class="form-label">Correo electrónico <span class="text-danger">*</span></label>
            <input asp-for="Form.Correo" type="email" class="form-control" required autocomplete="off" />
            <span asp-validation-for="Form.Correo" class="text-danger small"></span>
        </div>

        @if (!Model.Edicion)
        {
            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="Form.Telefono" class="form-label">Teléfono</label>
                <input asp-for="Form.Telefono" class="form-control" inputmode="tel" autocomplete="off" />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="Form.CodigoTipoTelefono" class="form-label">Tipo de teléfono</label>
                <select asp-for="Form.CodigoTipoTelefono" asp-items="tipos" class="form-select">
                    <option value="">— Seleccione —</option>
                </select>
            </div>
        }
    </div>

    <p class="text-muted small">
        <i class="bi bi-info-circle me-1"></i>
        @if (Model.Edicion)
        {
            <text>Los teléfonos y las direcciones se administran desde la ficha del cliente.</text>
        }
        else
        {
            <text>Después de guardar podrá agregar más teléfonos y las direcciones del cliente.</text>
        }
    </p>

    <div class="d-flex flex-wrap gap-2 justify-content-end">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>@(Model.Edicion ? "Guardar cambios" : "Registrar cliente")
        </button>
    </div>
</form>
