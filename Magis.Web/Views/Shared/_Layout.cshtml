@{
    var tituloPagina = ViewData["Title"] as string;
    var tituloDocumento = string.IsNullOrWhiteSpace(tituloPagina) ? "MAGIS-AUTO" : tituloPagina + " · MAGIS-AUTO";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@tituloDocumento</title>
    <link rel="icon" type="image/png" href="~/img/logo-icono.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/magis.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body>
    @* Barra superior: solo en pantallas pequeñas *@
    <header class="mg-topbar d-lg-none no-print">
        <button class="btn btn-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuMovil"
                aria-controls="menuMovil" aria-label="Abrir menú">
            <i class="bi bi-list fs-4"></i>
        </button>
        <a asp-controller="Home" asp-action="Index" class="mg-topbar-marca">
            <img src="~/img/logo-icono.png" alt="" />
            <strong>MAGIS-AUTO</strong>
        </a>
    </header>

    @* Menú lateral fijo *@
    <aside class="mg-sidebar d-none d-lg-flex no-print">
        <partial name="_Menu" />
    </aside>

    @* Menú deslizable *@
    <div class="offcanvas offcanvas-start mg-offcanvas no-print" tabindex="-1" id="menuMovil" aria-label="Menú de navegación">
        <div class="offcanvas-header pb-0">
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="offcanvas" aria-label="Cerrar menú"></button>
        </div>
        <div class="offcanvas-body p-0 d-flex flex-column">
            <partial name="_Menu" />
        </div>
    </div>

    <main class="mg-main">
        <div class="mg-contenido">
            @* Encabezado que solo aparece al imprimir *@
            <div class="solo-impresion mg-cabecera-impresion">
                <img src="~/img/logo.png" alt="MAGIS-AUTO" />
                <span>Impreso el @Formato.FechaHora(DateTime.Now)</span>
            </div>

            <partial name="_Alertas" />

            @RenderBody()
        </div>

        <footer class="mg-footer no-print">
            MAGIS-AUTO, S.A. · Proyecto final de Base de Datos I · Universidad Mariano Gálvez de Guatemala
        </footer>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/magis.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
