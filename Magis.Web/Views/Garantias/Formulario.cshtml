@model GarantiaFormVm
@{
    var titulo = Model.Edicion ? "Editar vehículo" : "Nuevo vehículo";
    ViewData["Title"] = titulo;
    var marcas = Model.Marcas.Select(o => new SelectListItem(o.Texto, o.Valor)).ToList();
    var lineas = Model.Lineas.Select(o => new SelectListItem(o.Texto, o.Valor)).ToList();
    var tipos = Model.Tipos.Select(o => new SelectListItem(o.Texto, o.Valor)).ToList();
    var anioMaximo = DateTime.Today.Year + 1;
}

<div class="mg-encabezado">
    <div>
        <h1>@titulo</h1>
        <p>Los campos marcados con <span class="text-danger">*</span> son obligatorios.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i>Volver a garantías
    </a>
</div>

<form asp-action="@(Model.Edicion ? "Editar" : "Crear")" method="post" class="mg-panel" data-bloquear>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.Edicion)
    {
        <input type="hidden" asp-for="Form.CodigoGarantia" />
    }

    <h2 class="mg-subtitulo">Identificación del vehículo</h2>
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-4">
            <label asp-for="Form.VIN" class="form-label">VIN <span class="text-danger">*</span></label>
            <input asp-for="Form.VIN" class="form-control" required maxlength="40" autocomplete="off" />
            <span asp-validation-for="Form.VIN" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            <label asp-for="Form.CodigoMarca" class="form-label">Marca <span class="text-danger">*</span></label>
            <select asp-for="Form.CodigoMarca" asp-items="marcas" class="form-select" required>
                <option value="">— Seleccione —</option>
            </select>
            <span asp-validation-for="Form.CodigoMarca" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            <label asp-for="Form.CodigoLinea" class="form-label">Línea <span class="text-danger">*</span></label>
            <select asp-for="Form.CodigoLinea" asp-items="lineas" class="form-select" required
                    data-url="@Url.Action("Lineas", "Garantias")">
                <option value="">@(string.IsNullOrWhiteSpace(Model.Form.CodigoMarca) ? "— Seleccione una marca —" : "— Seleccione —")</option>
            </select>
            <span asp-validation-for="Form.CodigoLinea" class="text-danger small"></span>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.AnioFabricacion" class="form-label">Año de fabricación <span class="text-danger">*</span></label>
            <input asp-for="Form.AnioFabricacion" type="number" class="form-control" required
                   min="1990" max="@anioMaximo" step="1" inputmode="numeric" />
            <span asp-validation-for="Form.AnioFabricacion" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.Placa" class="form-label">Placa</label>
            <input asp-for="Form.Placa" class="form-control" maxlength="20" autocomplete="off" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.Chasis" class="form-label">Chasis</label>
            <input asp-for="Form.Chasis" class="form-control" maxlength="40" autocomplete="off" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <label asp-for="Form.Serie" class="form-label">Serie</label>
            <input asp-for="Form.Serie" class="form-control" maxlength="40" autocomplete="off" />
        </div>
    </div>

    <h2 class="mg-subtitulo">Valor</h2>
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-4">
            <label asp-for="Form.ValorAgencia" class="form-label">Valor de agencia (Q) <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text">Q</span>
                <input asp-for="Form.ValorAgencia" type="number" class="form-control" required
                       min="0.01" step="0.01" inputmode="decimal" placeholder="0.00" />
            </div>
            <span asp-validation-for="Form.ValorAgencia" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            <label asp-for="Form.PorcentajeDepreciacion" class="form-label">Depreciación anual (%)</label>
            <div class="input-group">
                <input asp-for="Form.PorcentajeDepreciacion" type="number" class="form-control"
                       min="15" max="20" step="0.01" inputmode="decimal" placeholder="Entre 15 y 20" />
                <span class="input-group-text">%</span>
            </div>
            <div class="form-text">Opcional: entre 15 y 20. Si lo deja vacío se usa el valor por defecto del sistema.</div>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            <label asp-for="Form.TipoGarantia" class="form-label">Tipo de garantía</label>
            <select asp-for="Form.TipoGarantia" asp-items="tipos" class="form-select">
                <option value="">— Predeterminado —</option>
            </select>
        </div>
        <div class="col-12">
            <label asp-for="Form.Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Form.Descripcion" class="form-control" rows="2" maxlength="250"></textarea>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 justify-content-end">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>@(Model.Edicion ? "Guardar cambios" : "Registrar vehículo")
        </button>
    </div>
</form>

@section Scripts {
    <script src="~/js/garantias.js" asp-append-version="true"></script>
}
