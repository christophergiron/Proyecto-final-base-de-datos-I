# ===========================================================================
# MAGIS-AUTO - .gitignore (Visual Studio / .NET)


# --- Salida de compilacion ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
publish/
out/

# --- Archivos personales de Visual Studio ---
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.vsidx
*.vspscc
*.vssscc
launchSettings.json.user

# --- Resultados de pruebas y cobertura ---
TestResults/
*.trx
*.coverage

# --- Paquetes NuGet restaurados ---
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# --- Configuracion privada ---
appsettings.Local.json
appsettings.*.Local.json
secrets.json
.env
.env.*

# --- Bases de datos LocalDB y respaldos ---
*.mdf
*.ldf
*.ndf
*.bak
*.bacpac

# --- Registros y temporales ---
*.log
*.tmp
*.tmp_proj
*.cache
~$*
Thumbs.db
.DS_Store
*.swp

# --- Otros editores ---
.idea/
.vscode/*
!.vscode/extensions.json
